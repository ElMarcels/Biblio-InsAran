// Esquema de datos de la Biblioteca Institut d'Aran.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // En proveedores con "pooling" (p. ej. Neon) la URL de conexión agrupada no
  // admite los bloqueos que necesitan las migraciones. `DIRECT_URL` apunta a la
  // conexión directa y la usa el CLI al migrar. En instalaciones locales puede
  // ser igual que DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

/// Rol dentro de la plataforma.
/// OWNER  -> dueño de la plataforma: gestiona usuarios y puede borrar libros.
/// ADMIN  -> administración: mismos permisos y opciones que la cuenta de dueño.
/// EDITOR -> usuario creado por el dueño: puede añadir y editar libros.
enum Role {
  OWNER
  ADMIN
  EDITOR
}

/// Cuenta de la plataforma.
model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  displayName        String
  passwordHash       String
  role               Role      @default(EDITOR)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())

  createdById  String?
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[]  @relation("UserCreatedBy")

  sessions     Session[]
  booksCreated Book[]     @relation("BookCreatedBy")
  booksUpdated Book[]     @relation("BookUpdatedBy")
  auditLogs    AuditLog[]

  loansCreated        Loan[]        @relation("LoanCreatedBy")
  reservationsCreated Reservation[] @relation("ReservationCreatedBy")
  collectionsCreated  Collection[]  @relation("CollectionCreatedBy")

  changelogsCreated Changelog[]     @relation("ChangelogCreatedBy")
  changelogViews    ChangelogView[] @relation("ChangelogViewUser")

  /// Solicitudes de compra propuestas desde el panel.
  purchaseSuggestions PurchaseSuggestion[] @relation("PurchaseSuggestionUser")

  @@index([role])
  @@index([active])
}

/// Sesión iniciada. El token se guarda hasheado (nunca en claro).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

/// Libro del catálogo.
model Book {
  id           String   @id @default(cuid())
  title        String
  author       String
  isbn         String?
  publisher    String?
  year         Int?
  category     String
  language     String   @default("Español")
  pages        Int?
  copies       Int      @default(1)
  location     String?
  description  String?
  tags         String[] @default([])
  /// Número de registro de inventario. Se usa en las cuentas anuales.
  recordNumber String?
  /// Clasificación Decimal Universal (p. ej. 821.134.2-3).
  cdu          String?
  /// URL de la portada (Open Library u otra fuente permitida). Si falta,
  /// se dibuja la portada tipográfica generada a partir del título.
  coverUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("BookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("BookUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  loans               Loan[]
  reservations        Reservation[]
  collections         BookCollection[]
  /// Solicitudes de compra que se aprobaron creando este libro.
  purchaseSuggestions PurchaseSuggestion[] @relation("PurchaseSuggestionBook")

  @@index([title])
  @@index([author])
  @@index([category])
  @@index([recordNumber])
  @@index([createdAt])
}

/// Lista de libros ("Novedades", "Recomendados", "Club de lectura"…).
/// El orden dentro de la lista lo decide el personal a mano.
///
/// Si `ownerReaderId` está informado, la lista es privada y pertenece a esa
/// persona lectora: no aparece en el catálogo público ni en las listas curadas
/// del panel, solo en su área «Mi biblioteca».
model Collection {
  id            String   @id @default(cuid())
  /// Identificador para la URL pública (`/colecciones/<slug>`).
  slug          String   @unique
  name          String
  description   String?
  /// Orden de la lista entre las demás colecciones.
  position      Int      @default(0)
  /// Persona lectora propietaria de la lista (si es privada).
  ownerReaderId String?
  ownerReader   Reader?  @relation("CollectionOwnerReader", fields: [ownerReaderId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("CollectionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  books BookCollection[]

  @@index([position])
  @@index([ownerReaderId])
}

/// Pertenencia de un libro a una colección, con su posición manual.
model BookCollection {
  bookId       String
  book         Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// Orden manual dentro de la colección (menor = antes).
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@id([bookId, collectionId])
  @@index([collectionId, position])
}

/// Lector/a de la biblioteca (alumnado, profesorado, familias…).
/// No dispone de cuenta en la plataforma: es el personal quien gestiona sus
/// préstamos y reservas. Sí puede entrar en «Mi biblioteca» con su carné y un
/// PIN (ver `reader-auth.ts`).
model Reader {
  id                String    @id @default(cuid())
  cardNumber        String?   @unique
  fullName          String
  groupName         String?
  email             String?
  phone             String?
  active            Boolean   @default(true)
  /// PIN de acceso a «Mi biblioteca», guardado con bcrypt. `null` significa
  /// que sigue vigente el PIN inicial compartido: la primera vez que entra,
  /// la persona debe elegir el suyo (`pinMustChange`).
  pinHash           String?
  pinMustChange     Boolean   @default(true)
  /// Última vez que inició sesión en «Mi biblioteca».
  lastReaderLoginAt DateTime?
  /// Fecha hasta la que el lector/a tiene el préstamo suspendido por retrasos
  /// u otras incidencias. Si es nula o ya ha pasado, no hay sanción vigente.
  suspendedUntil    DateTime?
  /// Motivo de la suspensión vigente.
  suspensionReason  String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  loans               Loan[]
  reservations        Reservation[]
  sessions            ReaderSession[]
  /// Listas de lectura privadas de esta persona.
  collections         Collection[]         @relation("CollectionOwnerReader")
  /// Solicitudes de compra que ha propuesto.
  purchaseSuggestions PurchaseSuggestion[] @relation("PurchaseSuggestionReader")
  /// Avisos recibidos (correo y bandeja de «Mi biblioteca»).
  notifications       Notification[]

  @@index([fullName])
  @@index([active])
  @@index([suspendedUntil])
}

/// Sesión de «Mi biblioteca» (área del lector/a). El token se guarda hasheado.
model ReaderSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  readerId  String
  reader    Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([readerId])
  @@index([expiresAt])
}

/// Préstamo de un ejemplar a un lector/a.
/// `returnedAt` nulo significa que sigue en préstamo; si además `dueAt` ya ha
/// pasado, el préstamo está vencido (se calcula, no se almacena).
model Loan {
  id         String    @id @default(cuid())
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  readerId   String
  reader     Reader    @relation(fields: [readerId], references: [id], onDelete: Cascade)
  loanedAt   DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  /// Prórrogas aplicadas al préstamo (las decide el personal o la persona
  /// lectora desde «Mi biblioteca»; el límite de estas última es propio).
  renewals   Int       @default(0)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  createdById String?
  createdBy   User?   @relation("LoanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([readerId])
  @@index([returnedAt])
  @@index([dueAt])
}

/// Estado de una reserva.
/// ACTIVE    -> pendiente de servir (el lector/a espera el libro).
/// FULFILLED -> ya se ha entregado (normalmente convertida en préstamo).
/// CANCELLED -> anulada por el personal.
enum ReservationStatus {
  ACTIVE
  FULFILLED
  CANCELLED
}

/// Reserva de un libro por parte de un lector/a.
model Reservation {
  id         String            @id @default(cuid())
  bookId     String
  book       Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  readerId   String
  reader     Reader            @relation(fields: [readerId], references: [id], onDelete: Cascade)
  status     ReservationStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime          @default(now())
  resolvedAt DateTime?

  createdById String?
  createdBy   User?   @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([readerId])
  @@index([status])
}

/// Registro de actividad (auditoría) para dar trazabilidad a la plataforma.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  summary    String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entityType])
}

/// Novedad de la plataforma publicada por la dirección (dueño o rol ADMIN).
/// Se muestra automáticamente a cada cuenta de personal la próxima vez que
/// entra, una sola vez: al cerrar el aviso se registra la lectura en
/// `ChangelogView` y ya no vuelve a aparecer hasta la siguiente publicación.
model Changelog {
  id        String   @id @default(cuid())
  title     String
  /// Contenido en Markdown.
  body      String
  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("ChangelogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  views ChangelogView[]

  @@index([createdAt])
}

/// Lectura de un changelog por una cuenta de personal.
model ChangelogView {
  changelogId String
  changelog   Changelog @relation(fields: [changelogId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("ChangelogViewUser", fields: [userId], references: [id], onDelete: Cascade)
  seenAt      DateTime  @default(now())

  @@id([changelogId, userId])
  @@index([userId])
}

/// Estado de una solicitud de compra.
enum PurchaseSuggestionStatus {
  /// PENDIENTE  -> en espera de que el personal la revise.
  /// APROBADA   -> se ha incorporado el título al catálogo.
  /// DESCARTADA -> no se va a incorporar.
  PENDING
  APPROVED
  REJECTED
}

/// Solicitud de compra de un título que todavía no está en el catálogo.
/// La propone el alumnado, el profesorado o el propio personal; la resuelve
/// el personal, que al aprobarla genera el libro en el catálogo.
model PurchaseSuggestion {
  id     String                   @id @default(cuid())
  title  String
  author String
  isbn   String?
  /// Motivo de la petición (para qué lo quiere, para qué curso…).
  reason String?
  status PurchaseSuggestionStatus @default(PENDING)

  /// Persona lectora que propone (cuando está identificada).
  readerId String?
  reader   Reader? @relation("PurchaseSuggestionReader", fields: [readerId], references: [id], onDelete: SetNull)

  /// Cuenta de personal que propone (cuando la propuesta sale del panel).
  userId String?
  user   User?   @relation("PurchaseSuggestionUser", fields: [userId], references: [id], onDelete: SetNull)

  /// Nombre y correo de quien propone sin cuenta (formulario público).
  proposerName  String?
  proposerEmail String?

  /// Libro creado en el catálogo al aprobar la solicitud.
  bookId String?
  book   Book?   @relation("PurchaseSuggestionBook", fields: [bookId], references: [id], onDelete: SetNull)

  /// Nota del personal al resolver la solicitud.
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Momento en que se resolvió (aprobada o descartada).
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([readerId])
  @@index([userId])
}

/// Aviso dirigido a una persona lectora. Vive en su bandeja de «Mi biblioteca»
/// y, si tiene correo, se envía también por email.
model Notification {
  id        String    @id @default(cuid())
  readerId  String
  reader    Reader    @relation(fields: [readerId], references: [id], onDelete: Cascade)
  /// Tipo de aviso: "loan", "reservation", "overdue", "suspension".
  kind      String
  /// Destinatario del correo (vacío si la persona no tiene correo).
  to        String
  subject   String
  body      String
  /// Cuándo se envió el correo (nulo si no se ha enviado o ha fallado).
  sentAt    DateTime?
  /// Cuándo lo ha leído la persona en «Mi biblioteca».
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readerId, readAt])
  @@index([kind])
}
