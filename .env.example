# Copia este archivo como `.env` y ajusta los valores.

# Cadena de conexión a PostgreSQL que usa la aplicación.
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/biblio_instituto?schema=public"

# Conexión directa (sin pooling) que usan las migraciones de Prisma.
# En local puede ser idéntica a DATABASE_URL. En proveedores con pooling
# (Neon, Supabase, etc.) es el mismo host sin el sufijo "-pooler".
DIRECT_URL="postgresql://usuario:contrasena@localhost:5432/biblio_instituto?schema=public"

# Clave con la que se firma la cookie de sesión (mínimo 32 caracteres).
# Genera una con: openssl rand -hex 32
SESSION_SECRET="cambia-esto-por-una-cadena-aleatoria-larga-de-64-caracteres"

# --- Correo (opcional) -------------------------------------------------------
# Si faltan SMTP_HOST o SMTP_FROM, la plataforma sigue funcionando: los avisos
# se guardan solo en la bandeja de «Mi biblioteca», sin enviar correo.
#
# SMTP_HOST="smtp.tuservidor.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"        # "true" para el puerto 465 (TLS directo).
# SMTP_USER="biblioteca@tuservidor.com"
# SMTP_PASSWORD="tu-contrasena"
# SMTP_FROM="Biblioteca Institut d'Aran <biblioteca@tuservidor.com>"
